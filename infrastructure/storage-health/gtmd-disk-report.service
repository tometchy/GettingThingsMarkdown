[Unit]
Description=GTMD publish scoped disk-health report to Kubernetes
After=network-online.target gtmd-disk-health.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/gtmd/report-publisher.env
ExecStart=/usr/bin/python3 -B /usr/local/lib/gtmd/storage-controller/publish_report.py --node ${GTM_NODE} --uid ${GTM_NODE_UID} --endpoint ${GTM_API_ENDPOINT} --ca /etc/gtmd/kube-ca.crt --token /etc/gtmd/report-token
TimeoutStartSec=60
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
