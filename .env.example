# Copy to .env locally. Never commit a real .env.
GTM_JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
GTM_DB=Data Source=gtm.sqlite
GTM_ADMIN_TOKEN=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET
GTM_DEV_LONG_TRIAL=false
# Optional Kubernetes node labels; set both to different provider names.
GTM_SYNC_CLOUD=
GTM_HISTORY_CLOUD=
# Public age recipient only. Keep private recovery identity OUTSIDE the cluster.
GTM_RECOVERY_AGE_RECIPIENT=
GTM_PUBLIC_URL=https://your-domain.example
GTM_WEB_ORIGIN=https://your-domain.example
GTM_STRIPE_SECRET_KEY=
GTM_STRIPE_WEBHOOK_SECRET=
# Stripe recurring USD price IDs must match server-side published amounts.
# Monthly: $1.99 / $5.99 / $24.99; annual: $17.88 / $59.88 / $239.88.
GTM_STRIPE_PRICE_BASIC_MONTH=
GTM_STRIPE_PRICE_BASIC_YEAR=
GTM_STRIPE_PRICE_PLUS_MONTH=
GTM_STRIPE_PRICE_PLUS_YEAR=
GTM_STRIPE_PRICE_PRO_MONTH=
GTM_STRIPE_PRICE_PRO_YEAR=

# Production email verification (required before tenant provisioning)
GTM_SMTP_HOST=
GTM_SMTP_PORT=587
GTM_SMTP_USERNAME=
GTM_SMTP_PASSWORD=
GTM_SMTP_FROM=
